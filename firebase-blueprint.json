{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Admin user profile",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"],
          "description": "Access control role"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        }
      },
      "required": ["email", "displayName", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization marker document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email"
        },
        "createdAt": {
          "type": "string",
          "description": "Admin role grant timestamp"
        }
      },
      "required": ["email"]
    },
    "Note": {
      "title": "Note",
      "description": "A/L Biology study note in Tamil with English terms",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "Note title in Tamil/English"
        },
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Biology topic classification"
        },
        "subtopic": {
          "type": "string",
          "maxLength": 150,
          "description": "Optional subtopic classification"
        },
        "content": {
          "type": "string",
          "maxLength": 50000,
          "description": "Detailed note content"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the authoring admin"
        },
        "authorName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of author"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last modification"
        }
      },
      "required": ["title", "topic", "content", "authorId"]
    },
    "PdfDoc": {
      "title": "PdfDoc",
      "description": "Biology PDF note reference and extracted searchable text",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "PDF document title"
        },
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Biology syllabus topic"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional note description"
        },
        "downloadUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "Download or view URL"
        },
        "fileName": {
          "type": "string",
          "maxLength": 255,
          "description": "Original file name"
        },
        "fileSize": {
          "type": "number",
          "description": "File size in bytes"
        },
        "extractedText": {
          "type": "string",
          "maxLength": 100000,
          "description": "Extracted text content from PDF used for search and AI grounding"
        },
        "authorId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of uploader"
        },
        "uploadedAt": {
          "type": "string",
          "description": "Upload ISO timestamp"
        }
      },
      "required": ["title", "topic", "downloadUrl", "authorId"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Biology curriculum topic category",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Tamil topic name"
        },
        "nameEn": {
          "type": "string",
          "maxLength": 100,
          "description": "English topic name"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Brief description"
        },
        "order": {
          "type": "number",
          "description": "Display order"
        }
      },
      "required": ["name", "nameEn"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Student quiz score and progress record",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the student"
        },
        "topic": {
          "type": "string",
          "maxLength": 100,
          "description": "Quiz topic name"
        },
        "score": {
          "type": "number",
          "description": "Number of correct answers"
        },
        "total": {
          "type": "number",
          "description": "Total number of questions"
        },
        "percentage": {
          "type": "number",
          "description": "Score percentage"
        },
        "completedAt": {
          "type": "string",
          "description": "Completion ISO timestamp"
        }
      },
      "required": ["userId", "topic", "score", "total", "completedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account profiles"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin authorization markers"
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Biology shared notes created by administrators"
    },
    "/pdfs/{pdfId}": {
      "schema": { "$ref": "#/entities/PdfDoc" },
      "description": "Biology PDF library metadata and extracted text"
    },
    "/topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Biology curriculum topic categories"
    },
    "/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "Student practice quiz attempts"
    }
  }
}
